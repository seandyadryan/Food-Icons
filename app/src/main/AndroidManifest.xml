<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Allow querying installed launchers and theme engines on Android 11+ -->
    <queries>
        <package android:name="com.teslacoilsw.launcher" />
        <package android:name="ch.deletescape.lawnchair.plah" />
        <package android:name="ch.deletescape.lawnchair" />
        <package android:name="app.lawnchair" />
        <package android:name="com.actionlauncher.playstore" />
        <package android:name="smartlauncher.net" />
        <package android:name="ginlemon.flowerfree" />
        <package android:name="bitpit.launcher" />
        <package android:name="com.hyperion.launcher" />
        <package android:name="com.anddoes.launcher" />
        <package android:name="org.adw.launcher" />
        <package android:name="com.gau.go.launcherex" />
        <package android:name="com.samsung.android.themedesigner" />
        <package android:name="com.sec.android.app.launcher" />
        <package android:name="com.mi.android.globalminusscreen" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Icon pack metadata for launchers -->
        <meta-data
            android:name="org.adw.launcher.icons.THEMES"
            android:resource="@xml/appfilter" />
        <meta-data
            android:name="com.novalauncher.THEME"
            android:resource="@xml/appfilter" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">

            <!-- App launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Nova Launcher -->
            <intent-filter>
                <action android:name="com.novalauncher.THEME" />
                <category android:name="com.novalauncher.category.CUSTOM_ICON_PACK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Apex Launcher -->
            <intent-filter>
                <action android:name="com.anddoes.launcher.THEME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Action Launcher -->
            <intent-filter>
                <action android:name="com.actionlauncher.THEME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- ADW Launcher -->
            <intent-filter>
                <action android:name="org.adw.ActivityStarter.THEMES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Go Launcher -->
            <intent-filter>
                <action android:name="com.gau.go.launcherex.theme" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Atom Launcher -->
            <intent-filter>
                <action android:name="com.dlto.atom.launcher.THEME" />
            </intent-filter>

            <!-- Smart Launcher -->
            <intent-filter>
                <action android:name="ginlemon.smartlauncher.THEMES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Lawnchair -->
            <intent-filter>
                <action android:name="app.lawnchair.ICONPACK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.teslacoilsw.launcher.THEME" />
                <category android:name="com.anddoes.launcher.THEME" />
            </intent-filter>

        </activity>

    </application>

</manifest>
