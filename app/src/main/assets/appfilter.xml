<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Background tile for all apps that don't have a custom icon -->
    <iconback img1="iconback" />
    <!-- Mask shape so unthemed icons fit nicely on the tile -->
    <iconmask img1="iconmask" />
    <iconupon img1="iconupon" />
    <!-- Scale unthemed icons so they sit inside the food tile -->
    <scale factor="0.72" />

    <!-- Popular Apps Mappings to Food Icons -->
    <!-- WhatsApp -->
    <item component="ComponentInfo{com.whatsapp/com.whatsapp.HomeActivity}" drawable="food_burger" />
    <item component="ComponentInfo{com.whatsapp/com.whatsapp.Main}" drawable="food_burger" />
    <item component="ComponentInfo{com.whatsapp.w4b/com.whatsapp.HomeActivity}" drawable="food_burger" />

    <!-- YouTube -->
    <item component="ComponentInfo{com.google.android.youtube/com.google.android.youtube.HomeActivity}" drawable="food_pizza" />
    <item component="ComponentInfo{com.google.android.youtube/com.google.android.apps.youtube.app.WatchWhileActivity}" drawable="food_pizza" />

    <!-- Google Chrome -->
    <item component="ComponentInfo{com.android.chrome/com.google.android.apps.chrome.Main}" drawable="food_coffee" />

    <!-- Instagram -->
    <item component="ComponentInfo{com.instagram.android/com.instagram.mainactivity.MainActivity}" drawable="food_donut" />

    <!-- TikTok -->
    <item component="ComponentInfo{com.zhiliaoapp.musically/com.ss.android.ugc.aweme.splash.SplashActivity}" drawable="food_ramen" />
    <item component="ComponentInfo{com.ss.android.ugc.trill/com.ss.android.ugc.aweme.splash.SplashActivity}" drawable="food_ramen" />

    <!-- Facebook -->
    <item component="ComponentInfo{com.facebook.katana/com.facebook.katana.LoginActivity}" drawable="food_taco" />
    <item component="ComponentInfo{com.facebook.katana/com.facebook.katana.MainActivity}" drawable="food_taco" />

    <!-- Spotify -->
    <item component="ComponentInfo{com.spotify.music/com.spotify.music.MainActivity}" drawable="food_drink" />

    <!-- Netflix -->
    <item component="ComponentInfo{com.netflix.mediaclient/com.netflix.mediaclient.ui.launch.UIWebViewActivity}" drawable="food_pizza" />

    <!-- Telegram -->
    <item component="ComponentInfo{org.telegram.messenger/org.telegram.ui.LaunchActivity}" drawable="food_sushi" />

    <!-- Twitter / X -->
    <item component="ComponentInfo{com.twitter.android/com.twitter.app.main.MainActivity}" drawable="food_meat" />

    <!-- Google Play Store -->
    <item component="ComponentInfo{com.android.vending/com.android.vending.AssetBrowserActivity}" drawable="food_burger" />

    <!-- Google Maps -->
    <item component="ComponentInfo{com.google.android.apps.maps/com.google.android.maps.MapsActivity}" drawable="food_sushi" />

    <!-- Gmail -->
