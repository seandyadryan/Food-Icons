    <!-- Camera (Google, Samsung, Xiaomi, Standard) -->
    <item component="ComponentInfo{com.google.android.GoogleCamera/com.android.camera.CameraLauncher}" drawable="food_avocado" />
    <item component="ComponentInfo{com.sec.android.app.camera/com.sec.android.app.camera.Camera}" drawable="food_avocado" />
    <item component="ComponentInfo{com.android.camera/com.android.camera.Camera}" drawable="food_avocado" />
    <item component="ComponentInfo{com.android.camera2/com.android.camera.CameraLauncher}" drawable="food_avocado" />

    <!-- Photos / Gallery -->
    <item component="ComponentInfo{com.google.android.apps.photos/com.google.android.apps.photos.home.HomeActivity}" drawable="food_icecream" />
    <item component="ComponentInfo{com.sec.android.gallery3d/com.sec.android.gallery3d.app.GalleryActivity}" drawable="food_icecream" />
